[sub_resource type="Resource" id="Curiosity"]
script = ExtResource("2")
id = "curiosity"
latitude = -4.5895
longitude = 137.4417
title = "Curiosity"
subtitle = "Mars Science Laboratory"
mission_id = "curiosity"
category = "mission"
mission_name = "Mars Science Laboratory"
launch_date = "2011-11-26"
landing_date = "2012-08-06"
date = "2012-08-06"
region_id = "gale"
site_id = "bradbury"
description = "A mobile laboratory investigating evidence of past environments that could have supported microbial life."
external_references = PackedStringArray("https://mars.nasa.gov/internal_resources/824/", "https://ntrs.nasa.gov/api/citations/20130011617/downloads/20130011617.pdf", "https://www.jpl.nasa.gov/news/nasa-mars-rover-begins-driving-at-bradbury-landing/")

[sub_resource type="Resource" id="Gale"]
script = ExtResource("3")
id = "gale"
latitude = -4.5
longitude = 137.4
title = "Gale Crater"
subtitle = "Curiosity landing region"
mission_id = "curiosity"
category = "region"
max_distance = 2.15
description = "A 154 km impact crater with a layered mountain at its center. Curiosity landed on its northern floor."
external_references = PackedStringArray("https://science.nasa.gov/resource/daybreak-at-gale-crater/", "https://science.nasa.gov/resource/gale-craters-history-book/")
deployment_scene = "res://main.tscn"
deployment_label = "Curiosity mobility field lab"
preload_paths = PackedStringArray("res://assets/curiosity.glb", "res://assets/ground.gdshader")

[sub_resource type="Resource" id="Bradbury"]
script = ExtResource("4")
id = "bradbury"
latitude = -4.5895
longitude = 137.4417
title = "Bradbury Landing"
subtitle = "Curiosity touchdown site"
mission_id = "curiosity"
region_id = "gale"
category = "site"
date = "2012-08-06"
max_distance = 1.55
description = "Curiosity's landing site, named for author Ray Bradbury. Coordinates follow the NASA landing reconstruction."
external_references = PackedStringArray("https://ntrs.nasa.gov/api/citations/20130011617/downloads/20130011617.pdf", "https://www.jpl.nasa.gov/news/nasa-mars-rover-begins-driving-at-bradbury-landing/")

